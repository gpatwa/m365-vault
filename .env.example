# Shieldio Configuration
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────
APP_NAME=Shieldio
APP_VERSION=1.3.0
DEBUG=false

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────
# SQLite for development. Use PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/m365vault
DATABASE_URL=sqlite+aiosqlite:///./m365_protection.db

# ── Storage Backend ────────────────────────────────────
# Options: local | azure | minio
STORAGE_BACKEND=local

# Local filesystem (when STORAGE_BACKEND=local)
BACKUP_STORAGE_PATH=./data

# Azure Blob Storage (when STORAGE_BACKEND=azure)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=m365vault-backups

# MinIO / S3 (when STORAGE_BACKEND=minio)
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=m365vault-backups
# MINIO_USE_SSL=false

# ── Encryption ─────────────────────────────────────────
# Must be exactly 32 bytes for AES-256. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
ENCRYPTION_MASTER_KEY=change-me-32-byte-master-key-!!

# ── Microsoft Graph API ──────────────────────────────────
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MS_GRAPH_BATCH_URL=https://graph.microsoft.com/v1.0/$batch
MS_AUTH_URL=https://login.microsoftonline.com
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Least-privilege scopes (v1.1.0) — used automatically by GraphClient
# Backup scopes (read-only): Mail.Read, Calendars.Read, Contacts.Read, Files.Read.All, Sites.Read.All, User.Read.All
# Restore scopes (read-write): Mail.ReadWrite, Calendars.ReadWrite, Contacts.ReadWrite, Files.ReadWrite.All, Sites.ReadWrite.All, User.Read.All

# ── Throttling ───────────────────────────────────────────
GRAPH_MAX_RETRIES=5
GRAPH_RETRY_BASE_DELAY=1.0
GRAPH_MAX_CONCURRENT_REQUESTS=10
GRAPH_BATCH_SIZE=20

# ── Compression ─────────────────────────────────────────
COMPRESSION_ENABLED=true
COMPRESSION_ZSTD_LEVEL_TEXT=9
COMPRESSION_ZSTD_LEVEL_BINARY=3
COMPRESSION_MIN_SIZE=256

# ── Deduplication ───────────────────────────────────────
DEDUP_ENABLED=true
CDC_THRESHOLD_BYTES=4194304
CDC_TARGET_CHUNK_BYTES=65536
CDC_MIN_CHUNK_BYTES=16384
CDC_MAX_CHUNK_BYTES=262144

# ── Scheduler ────────────────────────────────────────────
SCHEDULER_CHECK_INTERVAL_SECONDS=60
