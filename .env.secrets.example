# ──────────────────────────────────────────────────────────────────────
# KavachIQ — Application Secrets
# ──────────────────────────────────────────────────────────────────────
# Copy to .env.secrets and fill in real values:
#   cp .env.secrets.example .env.secrets
#
# Then push to Azure Key Vault:
#   make secrets-push
#
# This file is the SINGLE SOURCE OF TRUTH for all application secrets.
# It is .gitignored. Key Vault is the runtime secret store.
# ──────────────────────────────────────────────────────────────────────

# ── Stripe Billing (test mode) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGEME
STRIPE_PRICE_PROFESSIONAL=price_CHANGEME
STRIPE_PRICE_BUSINESS=price_CHANGEME
STRIPE_PRICE_ENTERPRISE=price_CHANGEME

# ── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_CHANGEME

# ── Microsoft 365 Connector ─────────────────────────────────────────
CONNECTOR_APP_ID=CHANGEME
CONNECTOR_APP_SECRET=CHANGEME

# ── PostHog Analytics ───────────────────────────────────────────────
POSTHOG_API_KEY=phc_CHANGEME
