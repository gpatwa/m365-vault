server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Inject runtime API base URL as JavaScript for the SPA
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        return 200 'window.__RUNTIME_CONFIG__={API_BASE:"${BACKEND_URL}"};';
    }

    # index.html — NEVER cache so new deploys are picked up immediately
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # SPA fallback — serve index.html for client-side routing.
    # MUST set no-cache here because try_files serves index.html but the
    # headers from "location = /index.html" don't apply to internal redirects.
    # Without this, CDN caches HTML responses for SPA routes like /settings.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
    }

    # Cache hashed static assets forever (fingerprinted filenames change per build).
    # This block has higher priority than location / for matching asset URLs.
    # CDN-Cache-Control tells Cloudflare to cache at the edge (fast worldwide).
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header CDN-Cache-Control "max-age=31536000" always;
    }
}
